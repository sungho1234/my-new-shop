// 1. Prisma 클라이언트 설정 (수정 불필요)
generator client {
  provider = "prisma-client-js"
}

// 2. 데이터베이스 연결 설정 (기존 설정 유지)
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DATABASE_URL_UNPOOLED")
  relationMode = "prisma"
}

// 3. User (회원) 테이블 설계도 (하나로 통합)
model User {
  id        String    @id @default(cuid())
  kakaoId   String    @unique
  name      String?   // 카카오 'nickname' 저장용 (기존 파일의 nickname, name 필드 통합)
  email     String?   @unique
  image     String?   // 프로필 이미지 저장용
  createdAt DateTime  @default(now())

  // 관계 설정: User는 여러개의 찜 목록, 구매 내역, 체크리스트, 노트, 후기, 매매일지를 가질 수 있습니다.
  wishlist       WishlistItem[]
  purchases      Purchase[]
  checklists     UserChecklist[]
  notes          UserNote[]
  reviews        Review[]
  tradingRecords TradingRecord[]
}

// 4. WishlistItem (찜 목록) 테이블 설계도 (기존 정의 유지)
model WishlistItem {
  id        String   @id @default(cuid())
  productId String   // 상품 ID (예: 'g1', 'c2')
  createdAt DateTime @default(now())
  
  // User 모델과 연결
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 한 유저가 같은 상품을 여러 번 찜하는 것 방지
  @@unique([userId, productId])
}

// 5. Purchase (구매 내역) 테이블 설계도 (하나로 통합)
model Purchase {
  id        String   @id @default(cuid())
  productId String
  amount    Int      // 결제 금액 (기존 파일의 amount 필드 유지)
  createdAt DateTime @default(now())

  // User 모델과 연결
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 특정 유저의 구매내역을 빠르게 찾기 위한 인덱스
  @@index([userId])
}

// 6. UserChecklist (사용자 학습 체크리스트) 테이블
model UserChecklist {
  id           String    @id @default(cuid())
  userId       String
  productId    String    // 어떤 강의의 체크리스트인지
  checklistId  Int       // 체크리스트 항목 번호 (1, 2, 3, 4, 5)
  completed    Boolean   @default(false)
  completedAt  String?   // 완료 시각 (문자열 형태로 저장)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // User 모델과 연결
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 한 유저가 같은 강의의 같은 체크리스트를 중복으로 가질 수 없음
  @@unique([userId, productId, checklistId])
  @@index([userId, productId])
}

// 7. UserNote (사용자 학습 노트) 테이블
model UserNote {
  id          String   @id @default(cuid())
  userId      String
  productId   String   // 어떤 강의의 노트인지
  noteType    String   // 'question', 'insight', 'todo', 'reference'
  title       String
  content     String   @db.Text
  module      String   // 'MODULE 01' 등
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // User 모델과 연결
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 특정 유저의 특정 강의 노트를 빠르게 찾기 위한 인덱스
  @@index([userId, productId])
}

// 8. Review (후기) 테이블
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String   // 상품 ID (예: 'first-guide', 'system-builder')
  rating    Int      // 1~5 별점
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User 모델과 연결
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 한 유저가 같은 상품에 후기 1개만 작성 가능
  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

// 9. TradingRecord (매매 일지) 테이블
model TradingRecord {
  id                String   @id @default(cuid())
  userId            String
  no                Int      // 거래 번호
  symbol            String   // 'BTC/USDT', 'ETH/USDT', etc.
  entryDateTime     String   // 진입 일시
  exitDateTime      String   // 청산 일시
  positionDirection String   // 'LONG' or 'SHORT'
  leverage          Int      // 레버리지 배율 (1-50)
  positionSize      Float    // 포지션 사이즈
  entryPrice        Float    // 진입가
  exitPrice         Float    // 청산가
  pnl               Float    // 손익 (자동 계산값 저장)
  roi               Float    // ROI % (자동 계산값 저장)
  roundTripFee      Float    // 왕복 수수료
  entryReason       String   @db.Text // 진입 근거
  exitReason        String   @db.Text // 청산 근거
  entryEmotion      String   // 진입 감정
  exitEmotion       String   // 청산 감정
  lessonLearned     String   @db.Text // 교훈
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // User 모델과 연결
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 특정 유저의 거래 기록을 빠르게 찾기 위한 인덱스
  @@index([userId])
  @@index([userId, entryDateTime])
}
