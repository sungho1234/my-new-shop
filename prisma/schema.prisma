// 1. Prisma 클라이언트 설정 (수정 불필요)
generator client {
  provider = "prisma-client-js"
}

// 2. 데이터베이스 연결 설정 (기존 설정 유지)
datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DATABASE_URL_UNPOOLED")
  relationMode = "prisma"
}

// 3. User (회원) 테이블 설계도 (하나로 통합)
model User {
  id        String    @id @default(cuid())
  kakaoId   String    @unique
  name      String?   // 카카오 'nickname' 저장용 (기존 파일의 nickname, name 필드 통합)
  email     String?   @unique
  image     String?   // 프로필 이미지 저장용
  createdAt DateTime  @default(now())
  
  // 관계 설정: User는 여러개의 찜 목록과 구매 내역을 가질 수 있습니다.
  wishlist  WishlistItem[]
  purchases Purchase[]
}

// 4. WishlistItem (찜 목록) 테이블 설계도 (기존 정의 유지)
model WishlistItem {
  id        String   @id @default(cuid())
  productId String   // 상품 ID (예: 'g1', 'c2')
  createdAt DateTime @default(now())
  
  // User 모델과 연결
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 한 유저가 같은 상품을 여러 번 찜하는 것 방지
  @@unique([userId, productId])
}

// 5. Purchase (구매 내역) 테이블 설계도 (하나로 통합)
model Purchase {
  id        String   @id @default(cuid())
  productId String
  amount    Int      // 결제 금액 (기존 파일의 amount 필드 유지)
  createdAt DateTime @default(now())
  
  // User 모델과 연결
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 특정 유저의 구매내역을 빠르게 찾기 위한 인덱스
  @@index([userId])
}
